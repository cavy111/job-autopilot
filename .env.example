QWEN_API_KEY=your_qwen_api_key_here

# Identity used on outgoing application + follow-up emails
SENDER_NAME=Your Name
SENDER_EMAIL=you@example.com
SENDER_PHONE=

# Dashboard login (Basic Auth). Set BOTH to require a username/password on the
# deployed dashboard. Leave unset for open access (e.g. local development).
DASH_USER=
DASH_PASS=
